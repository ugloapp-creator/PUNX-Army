# Security and caching headers for punxarmy.com
#
# Cloudflare Pages and Netlify both read this file verbatim. Vercel users:
# see vercel.json, which carries the same set. Nginx/Caddy: the same header
# names and values apply, in that server's own syntax.
#
# The CSP below is written against what the page ACTUALLY does. Read the
# notes before loosening anything - each 'unsafe' below is there for a
# specific reason and removing the reason should remove the exception.

/*
  # --- Content Security Policy -------------------------------------------
  # script-src 'unsafe-inline': the whole app is one inline <script>. That is
  #   the architecture (a single self-contained file), so inline script cannot
  #   be forbidden. It is bounded instead: there is no eval, no new Function,
  #   no dynamic script injection anywhere in the build, and every value that
  #   reaches the DOM is either textContent or run through esc()/mark().
  #   If you ever split the app into external files, drop 'unsafe-inline'.
  # style-src / font-src Google: ONLY the Permanent Marker handwriting face on
  #   the initiation page. Every other font is self-hosted in /fonts. Disclosed
  #   on /privacy. Drop both Google hosts if you ever self-host that face too.
  # Google Analytics (googletagmanager.com, google-analytics.com): loaded by
  #   /consent.js ONLY after a visitor taps "Accept analytics". Before that,
  #   nothing from Google Analytics runs and no cookie is set. See /privacy/#storage.
  # connect-src: the page fetches its own song file (to cut the glimpses of
  #   it) and posts the email sign-up to this site (Netlify Forms backup) and
  #   to Kit (app.kit.com, the mailing list). Nothing else.
  # img-src / media-src: every image, clip and the song are files on this
  #   origin. data: and blob: are kept because the Archive File is drawn on a
  #   canvas and handed to the visitor as an image.
  # Spotify (open.spotify.com, embed-cdn.spotifycdn.com): /tapes/ only. Spotify's embed script and its
  #   player iframe load the moment a visitor puts a tape in the deck, never
  #   on page load. Disclosed on /privacy. Drop both if /tapes/ ever goes.
  # frame-ancestors 'none': this page may not be framed by anyone, which is
  #   what stops clickjacking. It supersedes X-Frame-Options in modern
  #   browsers; the old header is kept below for old ones.
  # form-action 'self': the only form is the transmission sign-up, which posts
  #   to this site (Netlify Forms). Nothing may submit a form anywhere else.
  # base-uri 'none': stops an injected <base> from re-pointing relative URLs.
  # object-src 'none': no Flash/Java/plugin surface at all.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://open.spotify.com https://embed-cdn.spotifycdn.com; frame-src https://open.spotify.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; media-src 'self' data: blob:; connect-src 'self' https://app.kit.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-ancestors 'none'; form-action 'self'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests

  # --- Transport ----------------------------------------------------------
  # Two years, subdomains included. This is what enforces https: a browser
  # that has seen this header once will refuse plain http for punxarmy.com
  # and every subdomain until it expires. Only add "preload" once you are
  # certain you will never want plain http on any punxarmy.com subdomain.
  Strict-Transport-Security: max-age=63072000; includeSubDomains

  # --- Everything else ----------------------------------------------------
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  # The page needs none of these. Denying them means an injected script
  # cannot quietly reach for a camera or a location either.
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# --- Caching ---------------------------------------------------------------
# HTML is small (~110 KB) and changes when you redeploy, so cache it
# briefly and revalidate. Assets are content that never changes under the same
# name, so they get a year and "immutable" - which is what makes the second
# visit essentially instant.

/index.html
  Cache-Control: public, max-age=300, must-revalidate
/rights/*
  Cache-Control: public, max-age=300, must-revalidate
/privacy/*
  Cache-Control: public, max-age=300, must-revalidate
/terms/*
  Cache-Control: public, max-age=300, must-revalidate
/tapes/
  Cache-Control: public, max-age=300, must-revalidate
/tapes/index.html
  Cache-Control: public, max-age=300, must-revalidate
/tapes/f/*
  Cache-Control: public, max-age=604800
/tapes/t/*
  Cache-Control: public, max-age=604800
/tapes/s*
  Cache-Control: public, max-age=604800
/consent.js
  Cache-Control: public, max-age=300, must-revalidate
/.well-known/gpc.json
  Content-Type: application/json
  Cache-Control: public, max-age=86400
/_work/*
  X-Robots-Tag: noindex

/audio/*
  Cache-Control: public, max-age=31536000, immutable
  Accept-Ranges: bytes
/video/*
  Cache-Control: public, max-age=604800
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Accept-Ranges: bytes
/og-image.jpg
  Cache-Control: public, max-age=31536000, immutable
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000, immutable

# Crawlers should always get a fresh copy of these two.
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8
/robots.txt
  Cache-Control: public, max-age=3600

# Personal code links are private doors: keep them out of search results.
/t/*
  X-Robots-Tag: noindex, nofollow

/casting/*
  Cache-Control: public, max-age=300, must-revalidate

/pass/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/passport/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
